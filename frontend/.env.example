# Base URL of the iterait backend agent (Node on DigitalOcean).
# Leave the mock flag on until the backend endpoints are live.
VITE_API_BASE=http://localhost:4000

# When "true", the API client returns canned data instead of calling the
# backend — so the frontend runs fully before the backend exists.
# Set to "false" once VITE_API_BASE points at a running backend.
VITE_USE_MOCKS=true
